<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>usecase-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>data-transfer-demo</artifactId>
    <name>data-transfer-demo</name>
    <description>Data Transfer 端到端示例：电商订单 → CRM 全旅程 + 契约测试示范（core 无 Spring 亦可独立使用的实证）</description>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>data-transfer-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 契约测试示范 -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>data-transfer-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 断言（Schema 校验结果的 boolean 断言；版本由 Boot BOM 管理） -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
