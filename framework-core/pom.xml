<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>usecase-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>usecase-framework-core</artifactId>
    <name>usecase-framework-core</name>
    <description>用例编排框架本体：step 管道 / YAML 装配 / RouterFunction 绑定 / 认证与编解码 / Spring Boot 自动配置</description>

    <dependencies>
        <!-- 入站适配：Web MVC（framework.web 的 RouterFunction / ServerRequest） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 出站能力：RestClient（HttpRequester step / AuthHandler） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- 事务同步：eventPublisher step 的 afterCommit 发布时机保障（版本由 Boot BOM 管理） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!-- step config 声明式校验：类型化 config record + Bean Validation 注解（装配期 fail-fast，
             替代 StepFactory 内散落的命令式 null check；版本由 Boot BOM 管理） -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>

        <!-- Validator step：JSON Schema 校验（3.0.x 起基于 Jackson 3 / tools.jackson，与 Spring Boot 4 兼容） -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>3.0.6</version>
        </dependency>

        <!-- Lombok：仅编译期（provided + SOURCE retention），发布 jar 无运行期依赖；
             @Slf4j / @RequiredArgsConstructor / @UtilityClass 见 java-coding-standard §5.2 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
